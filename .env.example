# ==== LLM設定 ====
# LLMプロバイダー切替: openai または gemini
LLM_PROVIDER=openai

# OpenAI (https://platform.openai.com/api-keys で取得)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (https://aistudio.google.com/app/apikey で取得)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ==== Riot Games API設定（任意） ====
# 未設定・取得失敗時は静的サンプルデータ(meta_snapshot.json)に自動フォールバックします。
# 取得先: https://developer.riotgames.com/ (個人用キーは24時間で失効します)
RIOT_API_KEY=
RIOT_PLATFORM_REGION=jp1
RIOT_REGIONAL_ROUTE=asia
META_COLLECT_TOP_N=20
META_COLLECT_MATCHES_PER_PLAYER=5

# ==== RAG設定 ====
# ローカル埋め込みモデル（多言語対応、APIキー不要）
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
